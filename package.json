{
  "name": "kinforge-genealogy-studio",
  "version": "1.6.0",
  "description": "A local-first relationship mapping and genealogy studio for Mac.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run requirements:check && tsc && npm run build:glyphs && vite build && node scripts/prepare-offline.mjs && node scripts/build-cloud.mjs",
    "dev:cloud": "node scripts/dev-cloud.mjs",
    "test:cloud": "node --test tests/cloud-api.test.mjs tests/cloud-privacy.test.mjs tests/drive-sync.test.mjs",
    "build:web": "npm run build",
    "build:webapp": "npm run build",
    "build:website": "mkdir -p dist-website && cp -R website/* dist-website/",
    "test": "npm run requirements:check && vitest run",
    "requirements:refresh": "node scripts/requirements.mjs",
    "requirements:check": "node scripts/requirements.mjs --check",
    "build:glyphs": "node scripts/export-glyphs.mjs",
    "test:browser": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "electron": "npm run build && electron .",
    "package:mac": "npm run build && electron-builder --mac dmg pkg zip --arm64 --x64",
    "package:win": "npm run build && electron-builder --win nsis portable --x64",
    "package:all": "npm run build:webapp && electron-builder --mac dmg pkg zip --arm64 --x64 && electron-builder --win nsis portable --x64"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@lume/kiwi": "0.4.4",
    "@noble/hashes": "1.8.0",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vitejs/plugin-react": "^5.0.3",
    "@xyflow/react": "^12.11.6",
    "calendariale": "^0.7.0",
    "d3-geo": "^3.1.1",
    "drizzle-orm": "^0.45.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "typescript": "^5.9.2",
    "vite": "^5.4.20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "@playwright/test": "^1.63.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "mdast-util-from-markdown": "^2.0.2",
    "miniflare": "^3.20250718.3",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "@noble/hashes": "1.8.0"
  },
  "build": {
    "appId": "studio.kinforge.genealogy.supreme",
    "productName": "KinForge Genealogy Studio Supreme Suite",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/client/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.reference",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "pkg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    },
    "dmg": {
      "title": "KinForge Genealogy Studio Supreme Suite"
    }
  }
}
